{
  // Ask Glocky and the slip reader share the GEMINI_API_KEY Worker secret (`wrangler secret put GEMINI_API_KEY`; never commit it).
  "name": "glockys-cs2-props",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Beta login storage. No id on purpose: Wrangler (4.45+) creates the namespace on the first deploy and keeps it linked.
  // If you created one by hand in the dashboard instead, add  "id": "<namespace id>"  here.
  "kv_namespaces": [
    { "binding": "BETA" },
    // Community Wins posts + daily quotas. Same no-id pattern as BETA.
    { "binding": "WINS" }
  ],
  // Community Wins slip screenshots. Create the bucket once before the first deploy
  // (see README):  npx wrangler r2 bucket create glockyz-wins
  "r2_buckets": [{ "binding": "WINS_R2", "bucket_name": "glockyz-wins" }],
  // Slip reader uses Workers AI first (free Neuron allocation). Binding name is env.AI.
  "ai": { "binding": "AI" },
  "previews": {}
}
